{
  "name": "aiharness",
  "layout": {
    "src": "hooks",
    "e2e": "e2e",
    "adr": "adr"
  },
  "containers": {
    "allow": []
  },
  "validation": {
    "steps": [
      {
        "id": "unit",
        "kind": "unit",
        "runner": "vitest",
        "config": "vitest.config.mjs",
        "projects": ["harness"],
        "changedScoped": true
      }
    ],
    "extraForbidden": ["build", "e2e"]
  },
  "worktree": {
    "provision": "npm-link"
  },
  "roles": {
    "orchestrator": {
      "pipeline": false,
      "debounce": false,
      "validate": false,
      "model": "sonnet"
    },
    "planner": {
      "pipeline": true,
      "debounce": false,
      "validate": false,
      "model": "opus"
    },
    "developer": {
      "pipeline": true,
      "debounce": true,
      "validate": true,
      "model": "sonnet"
    },
    "simple-developer": {
      "pipeline": true,
      "debounce": false,
      "validate": true,
      "model": "sonnet"
    },
    "test-writer": {
      "pipeline": true,
      "debounce": false,
      "validate": true,
      "model": "sonnet"
    },
    "quality-reviewer": {
      "pipeline": true,
      "debounce": true,
      "validate": false,
      "model": "opus"
    },
    "merger": {
      "pipeline": true,
      "debounce": true,
      "validate": false,
      "model": "haiku"
    },
    "documentator": {
      "pipeline": false,
      "debounce": false,
      "validate": false,
      "model": "sonnet"
    }
  },
  "documentator": {
    "author": { "name": "Documentator", "email": "documentator@harness.local" }
  }
}
